# Copy this file to .env and add your Gemini API key from Google AI Studio.
LLM_API_KEY=replace_me
LLM_MODEL=gemini-3.5-flash-lite

# Gemini API endpoint.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gnani key is required only for the Step 4 voice features.
GNANI_API_KEY=replace_me
